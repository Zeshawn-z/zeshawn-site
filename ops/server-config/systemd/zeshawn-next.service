[Unit]
Description=Next.js standalone server
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/var/www/zeshawn-site/.next/standalone
ExecStart=/root/.nvm/versions/node/v20.20.1/bin/node server.js
Restart=always
RestartSec=5
Environment=NODE_ENV=production
Environment=PORT=3000

[Install]
WantedBy=multi-user.target
